#
# OpenTHC App Suite Environment File
#
# See openthc.org/docker for more information
#
# This is REQUIRED by the docker compose tools
#
# Also, one can source this file and run the "generator" scripts
#

# OPENTHC_ROOT_COMPANY_ID="010PENTHC0C0MPANY00000R00T"
# OPENTHC_DEMO_CONTACT_ID="010PENTHC0C0NTACT00000DEM0"
# OPENTHC_DEMO_CONTACT_USERNAME="demo@openthc.me"
# OPENTHC_DEMO_CONTACT_PASSWORD="passweed"
#

OPENTHC_ENV_FILE="demo.env"

# Set to "true" and then images will have xdebug enabled
OPENTHC_DEBUG="false"


OPENTHC_DSN_MAIN="pgsql:host=sql;user=openthc_main;password=openthc_main;dbname=openthc_main"
OPENTHC_DSN_AUTH="pgsql:host=sql;user=openthc_auth;password=openthc_auth;dbname=openthc_auth"
OPENTHC_DSN_CRE="pgsql:host=sql;user=openthc_cre;password=openthc_cre;dbname=openthc_cre"
OPENTHC_DSN_BONG="pgsql:host=sql;user=openthc_bong;password=openthc_bong;dbname=openthc_bong"


# SSO Configuration
OPENTHC_SSO_ID="010PENTHC0SERV1CE000000SS0"
OPENTHC_SSO_ORIGIN="http://sso.openthc.me"
OPENTHC_SSO_CLIENT="SOME ULID OR SOMETHING"

